{
  "name": "astrogamewar-functions",
  "description": "Firebase Cloud Functions for AstrogameWAR",
  "scripts": {
    "serve": "firebase --config ../firebase.json emulators:start --only functions --project \"$FIREBASE_PROJECT_ID\"",
    "deploy": "firebase --config ../firebase.json deploy --only functions --project \"$FIREBASE_PROJECT_ID\"",
    "logs": "firebase --config ../firebase.json functions:log --project \"$FIREBASE_PROJECT_ID\""
  },
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^4.9.0"
  },
  "private": true
}
